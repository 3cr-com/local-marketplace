# Public Supabase browser credentials. Do not put service-role secrets here.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_KEY=your-anon-key

# Used as the authenticated redirect host by the sign-in interface.
PUBLIC_AUTH_DOMAIN=localhost:4321

# Production canonical URL, enabling sitemap generation when set.
PUBLIC_SITE_URL=https://3cr.com
