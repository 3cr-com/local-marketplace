---
import '../styles/global.css';
import { Toaster } from 'sonner';

const { title = '3cr marketplace' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#315b42" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Toaster client:load position="top-right" richColors closeButton />
  </body>
</html>
